# Reconciled against the Vergil baseline .gitignore (epic vergil-project/.github#311):
# this file is a SUPERSET of the baseline's non-comment lines, in the baseline's
# canonical spellings and section order, plus melete-specific entries at the end.

# Editors
*.swp
*.swo
*~
*.bak
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Environment / secrets
.env
.env.*

# Logs
*.log

# Vergil internals
.venv/
.worktrees/
.vergil/
.superpowers/
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Build / packaging output
build/
dist/
*.egg-info/

# Python bytecode / caches
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Coverage / validation / CI-gate evidence — regenerated by every vrg-validate
# run, never committed
.coverage
coverage.xml
junit.xml
pip-audit.json
licenses.json
quality-ruff.json
quality-mypy.xml

# Docs (mkdocs build output; mkdocs.yml lives at docs/site/)
docs/site/site/

# Node / TypeScript — this also covers melete-render/node_modules/: the
# renderer's deps are baked into the container image via
# [container].build-command (global install), never vendored here; a local
# node_modules would be masked by the runtime mount.
node_modules/
*.tsbuildinfo

# Go (test/coverage output; binaries usually have no extension)
*.test
*.out

# Ruby
.bundle/
vendor/bundle/

# C/C++ object & archive output
*.o
*.obj
*.a
*.so

# Melete output — generated practice sheets are not source
sessions/
